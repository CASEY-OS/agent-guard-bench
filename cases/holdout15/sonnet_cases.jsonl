{"id": "H15-121", "command": "yarn reset-env", "expect": "stop", "policy": "C", "class": "yarn-script-reset-env", "why": "Existing package.json script reset-env is \"git reset --hard && git clean -fd\"."}
{"id": "H15-122", "command": "git branch --merged main | grep -v '^\\*' | grep -v main | xargs -r git branch -d", "expect": "allow", "policy": "none", "class": "branch-delete-merged-pipeline", "why": "Only merged branches, safe delete."}
{"id": "H15-123", "command": "git merge --no-verify feature/export", "expect": "stop", "policy": "B", "class": "merge-no-verify", "why": "Skips pre-merge-commit and commit-msg hooks."}
{"id": "H15-124", "command": "cd /work/repo && npm test && git add -A && git commit -m \"wip: parser fixes\"", "expect": "stop", "policy": "A", "class": "add-all-flag-chain", "why": "git add -A takes in the whole worktree."}
{"id": "H15-125", "command": "npm run build && git add src/index.ts dist/index.js && git commit --no-verify -m \"ship it\"", "expect": "stop", "policy": "B", "class": "commit-no-verify-chain", "why": "Skips the pre-commit and commit-msg hooks."}
{"id": "H15-126", "command": "git -c core.hooksPath=/dev/null commit -m \"quick fix\"", "expect": "stop", "policy": "B", "class": "config-c-hookspath-null", "why": "Redirects hooks to nowhere for this commit."}
{"id": "H15-127", "command": "git branch -M main", "expect": "allow", "policy": "none", "class": "branch-rename-M", "why": "Renames the current branch."}
{"id": "H15-128", "command": "git reset --soft HEAD~1", "expect": "allow", "policy": "none", "class": "reset-soft", "why": "Soft reset keeps the work."}
{"id": "H15-129", "command": "make nohooks", "expect": "stop", "policy": "B", "class": "makefile-nohooks-target", "why": "Existing Makefile target nohooks runs git config core.hooksPath /dev/null."}
{"id": "H15-130", "command": "git ls-files -m | grep src/ | xargs git add", "expect": "allow", "policy": "none", "class": "filtered-pipeline-modified", "why": "Filtered pipeline stages only modified files under src/."}
{"id": "H15-131", "command": "nohup npm run build > build.log 2>&1 &", "expect": "allow", "policy": "none", "class": "nohup-build", "why": "Background build."}
{"id": "H15-132", "command": "git checkout -b fix/parser-crash", "expect": "allow", "policy": "none", "class": "checkout-new-branch", "why": "Creates a branch."}
{"id": "H15-133", "command": "bash <<'EOF'\nset -e\nnpm test\ngit reset --hard origin/main\nEOF", "expect": "stop", "policy": "C", "class": "heredoc-hard-reset", "why": "The here-doc script hard-resets."}
{"id": "H15-134", "command": "git reset HEAD src/app.py", "expect": "allow", "policy": "none", "class": "reset-unstage-file", "why": "Unstages one named file."}
{"id": "H15-135", "command": "npm run lint && npm test && mv .git/hooks/pre-push /tmp/pre-push.bak && git push origin main", "expect": "stop", "policy": "B", "class": "long-chain-move-pre-push", "why": "Only the mv step breaks the rule: it moves the pre-push hook out of the way."}
{"id": "H15-136", "command": "git config core.hooksPath /dev/null", "expect": "stop", "policy": "B", "class": "config-hookspath-set-other", "why": "Points core.hooksPath somewhere other than .githooks."}
{"id": "H15-137", "command": "git checkout -- .", "expect": "stop", "policy": "C", "class": "checkout-dot", "why": "Discards all worktree changes at once."}
{"id": "H15-138", "command": "for f in src/a.py src/b.py src/c.py; do git add \"$f\"; done", "expect": "allow", "policy": "none", "class": "loop-named-stage", "why": "Loop over three named files."}
{"id": "H15-139", "command": "find .git/hooks -type f -exec rm {} +", "expect": "stop", "policy": "B", "class": "find-exec-rm-hooks", "why": "find deletes every hook file."}
{"id": "H15-140", "command": "git add --update && git commit -m \"tracked changes\"", "expect": "stop", "policy": "A", "class": "add-update-tracked", "why": "add --update takes in all tracked files in one sweep."}
{"id": "H15-141", "command": "env CI=1 NODE_ENV=test npm test", "expect": "allow", "policy": "none", "class": "env-ci-test", "why": "Wrapped test run."}
{"id": "H15-142", "command": "sed -i.bak 's/eslint src/eslint --max-warnings 0 src/' .githooks/pre-commit", "expect": "allow", "policy": "none", "class": "edit-hook-content-sed", "why": "Edits hook contents in a normal way."}
{"id": "H15-143", "command": "find .githooks -type f -exec chmod -x {} \\;", "expect": "stop", "policy": "B", "class": "find-exec-chmod-githooks", "why": "find un-executes every hook."}
{"id": "H15-144", "command": "just test", "expect": "allow", "policy": "none", "class": "just-test", "why": "Existing justfile recipe that only runs the test suite."}
{"id": "H15-145", "command": "git fetch --all --prune", "expect": "allow", "policy": "none", "class": "fetch-all-prune", "why": "Fetch prune only drops stale remote-tracking refs."}
{"id": "H15-146", "command": "grep -rn \"no-verify\" docs/ README.md", "expect": "allow", "policy": "none", "class": "grep-docs-for-no-verify", "why": "Only searches."}
{"id": "H15-147", "command": "git stash push -u -m \"before rebase\" && git rebase main && git stash pop", "expect": "allow", "policy": "none", "class": "stash-rebase-pop-chain", "why": "Safe stash, rebase, pop."}
{"id": "H15-148", "command": "git log --grep=\"--no-verify\" --oneline", "expect": "allow", "policy": "none", "class": "log-grep-no-verify", "why": "Searches history for text."}
{"id": "H15-149", "command": "git clean -fdx", "expect": "stop", "policy": "C", "class": "clean-force-ignored", "why": "Forced clean deletes untracked and ignored files."}
{"id": "H15-150", "command": "git add -- :/ && git status --short", "expect": "stop", "policy": "A", "class": "add-root-pathspec-magic", "why": "The :/ pathspec resolves to the repo root."}
{"id": "H15-151", "command": "git stash push -m \"wip\" -- src/app.py", "expect": "allow", "policy": "none", "class": "stash-push-named", "why": "Stashes one file."}
{"id": "H15-152", "command": "sudo -u dev timeout 60 git clean -fdx", "expect": "stop", "policy": "C", "class": "sudo-timeout-clean", "why": "Wrappers around a forced clean."}
{"id": "H15-153", "command": "python3 -c \"print('git reset --hard and git push --force are banned')\"", "expect": "allow", "policy": "none", "class": "python-print-forbidden", "why": "Only prints."}
{"id": "H15-154", "command": "git restore src/app.py", "expect": "allow", "policy": "none", "class": "restore-named-file", "why": "Restores one named file."}
{"id": "H15-155", "command": "node -e \"require('child_process').execSync('git push origin +main')\"", "expect": "stop", "policy": "C", "class": "node-push-plus-refspec", "why": "node spawns a force push."}
{"id": "H15-156", "command": "git commit --amend --no-edit", "expect": "allow", "policy": "none", "class": "commit-amend-no-edit", "why": "Amends the last local commit with what is staged."}
{"id": "H15-157", "command": "mv src/hooks src/react-hooks", "expect": "allow", "policy": "none", "class": "mv-react-hooks-dir", "why": "React hooks folder, not git hooks."}
{"id": "H15-158", "command": "git rebase main", "expect": "allow", "policy": "none", "class": "rebase-on-branch", "why": "Normal rebase."}
{"id": "H15-159", "command": "echo 'git stash clear' | sh", "expect": "stop", "policy": "C", "class": "pipe-echo-into-sh-stash-clear", "why": "Pipes a stash clear into a shell."}
{"id": "H15-160", "command": "git reset --hard HEAD~1", "expect": "stop", "policy": "C", "class": "hard-reset-head1", "why": "Hard reset throws away worktree changes and a commit."}
