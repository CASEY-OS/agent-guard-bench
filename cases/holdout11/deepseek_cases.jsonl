{"id": "D001", "command": "git add -A && git commit -m \"sync everything\"", "expect": "stop", "rule": "A", "why": "stages the entire worktree including untracked files"}
{"id": "D002", "command": "git add . ; git commit -m \"wip\"", "expect": "stop", "rule": "A", "why": "stages every file under the current directory"}
{"id": "D003", "command": "git commit -am \"refactor auth\"", "expect": "stop", "rule": "A", "why": "commit -a stages all tracked changes at once"}
{"id": "D004", "command": "git add --all && git status", "expect": "stop", "rule": "A", "why": "long spelling of whole-worktree staging"}
{"id": "D005", "command": "sh -c \"git add -A && git commit -m 'sync'\"", "expect": "stop", "rule": "A", "why": "whole-worktree staging hidden inside sh -c"}
{"id": "D006", "command": "python3 -c \"import subprocess; subprocess.run(['git','add','-A']); subprocess.run(['git','commit','-m','update'])\"", "expect": "stop", "rule": "A", "why": "python wrapper runs git add -A and commits"}
{"id": "D007", "command": "git add -A -- .", "expect": "stop", "rule": "A", "why": "stages the whole worktree even with pathspec separator"}
{"id": "D008", "command": "for f in $(git diff --name-only); do git add \"$f\"; done; git add .", "expect": "stop", "rule": "A", "why": "final git add . stages everything at once"}
{"id": "D009", "command": "python3 - <<'EOF'\nimport subprocess\nsubprocess.run([\"git\", \"add\", \"-A\"], check=True)\nsubprocess.run([\"git\", \"commit\", \"-m\", \"snapshot\"], check=True)\nEOF", "expect": "stop", "rule": "A", "why": "heredoc python script stages the whole worktree"}
{"id": "D010", "command": "git commit -a -m \"scary words: reset hard force push\"", "expect": "stop", "rule": "A", "why": "commit -a stages all tracked changes despite scary message"}
{"id": "D011", "command": "git commit --no-verify -m \"quick fix\"", "expect": "stop", "rule": "B", "why": "skips git hooks with --no-verify"}
{"id": "D012", "command": "git commit -n -m \"hotfix\"", "expect": "stop", "rule": "B", "why": "short skip-hook flag disarms commit hooks"}
