{"id": "D014", "command": "chmod -x .git/hooks/pre-push", "expect": "stop", "rule": "B", "why": "makes a hook non-executable"}
{"id": "D015", "command": "echo \"\" > .git/hooks/commit-msg", "expect": "stop", "rule": "B", "why": "empties a hook file"}
