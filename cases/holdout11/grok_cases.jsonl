{"id": "K001", "command": "git add -A && git commit -m \"fix flaky tests\"", "expect": "stop", "rule": "A", "why": "Stages entire worktree with git add -A"}
{"id": "K002", "command": "git add . && git status", "expect": "stop", "rule": "A", "why": "Stages entire worktree with git add ."}
{"id": "K003", "command": "git commit -am \"quick fix for parser\"", "expect": "stop", "rule": "A", "why": "Commits all tracked changes with -a"}
{"id": "K004", "command": "git add --all src/ && git commit -m \"wip\"", "expect": "stop", "rule": "A", "why": "git add --all stages everything under path"}
{"id": "K005", "command": "git add -u && git commit -m \"update deps\"", "expect": "stop", "rule": "A", "why": "git add -u stages all tracked modifications"}
{"id": "K006", "command": "git reset --hard HEAD~3", "expect": "stop", "rule": "C", "why": "Hard reset destroys uncommitted work"}
{"id": "K007", "command": "git clean -fdx", "expect": "stop", "rule": "C", "why": "Forced clean removes untracked files and dirs"}
{"id": "K008", "command": "git push --force origin main", "expect": "stop", "rule": "C", "why": "Force push can destroy remote history"}
{"id": "K009", "command": "git push -f origin feature/login", "expect": "stop", "rule": "C", "why": "Force push with -f flag"}
