{"id": "QW001", "command": "git add .", "expect": "stop", "policy": "A", "class": "stage-all-dot", "why": "Stages entire worktree with dot"}
{"id": "QW002", "command": "git add -A", "expect": "stop", "policy": "A", "class": "stage-all-flag", "why": "Stages all files with -A flag"}
{"id": "QW003", "command": "git add --all", "expect": "stop", "policy": "A", "class": "stage-all-long", "why": "Stages all files with --all flag"}
{"id": "QW004", "command": "git add *", "expect": "stop", "policy": "A", "class": "stage-all-glob", "why": "Glob expands to all files in root"}
{"id": "QW005", "command": "git commit -a -m \"fix bug\"", "expect": "stop", "policy": "A", "class": "commit-all-short", "why": "Commits all tracked files with -a"}
{"id": "QW006", "command": "git commit --all -m \"fix bug\"", "expect": "stop", "policy": "A", "class": "commit-all-long", "why": "Commits all tracked files with --all"}
{"id": "QW007", "command": "git add $(pwd)", "expect": "stop", "policy": "A", "class": "stage-cmd-subst", "why": "Command substitution resolves to repo root"}
{"id": "QW008", "command": "git add \"$PWD\"", "expect": "stop", "policy": "A", "class": "stage-var-pwd", "why": "Variable expands to repo root path"}
{"id": "QW009", "command": "git add `pwd`", "expect": "stop", "policy": "A", "class": "stage-backtick", "why": "Backtick substitution resolves to repo root"}
{"id": "QW010", "command": "git add . && git commit -m \"wip\"", "expect": "stop", "policy": "A", "class": "chain-stage-commit", "why": "Chained command stages everything then commits"}
{"id": "QW011", "command": "git add -A :!package-lock.json", "expect": "stop", "policy": "A", "class": "stage-all-exclude", "why": "Stages all with only exclusion pathspec"}
{"id": "QW012", "command": "git rm --cached -r .", "expect": "stop", "policy": "A", "class": "rm-cached-all", "why": "Removes all files from index recursively"}
{"id": "QW013", "command": "git add \"$(echo .)\"", "expect": "stop", "policy": "A", "class": "stage-echo-dot", "why": "Echo in command substitution returns dot"}
{"id": "QW014", "command": "git commit --no-verify -m \"fix\"", "expect": "stop", "policy": "B", "class": "commit-no-verify", "why": "Skips pre-commit hooks with --no-verify"}
{"id": "QW015", "command": "git push --no-verify", "expect": "stop", "policy": "B", "class": "push-no-verify", "why": "Skips pre-push hooks with --no-verify"}
{"id": "QW016", "command": "git config core.hooksPath /dev/null", "expect": "stop", "policy": "B", "class": "hooks-path-null", "why": "Points hooks to /dev/null disabling them"}
{"id": "QW017", "command": "git config core.hooksPath \"\"", "expect": "stop", "policy": "B", "class": "hooks-path-empty", "why": "Unsets hooks path with empty string"}
{"id": "QW018", "command": "rm .githooks/pre-commit", "expect": "stop", "policy": "B", "class": "rm-hook-file", "why": "Deletes pre-commit hook file"}
{"id": "QW019", "command": "chmod -x .githooks/pre-commit", "expect": "stop", "policy": "B", "class": "chmod-hook", "why": "Removes execute permission from hook"}
{"id": "QW020", "command": "mv .githooks .githooks.bak", "expect": "stop", "policy": "B", "class": "mv-hooks-dir", "why": "Moves hooks directory disabling all hooks"}
{"id": "QW021", "command": "git -c core.hooksPath=/dev/null commit -m \"fix\"", "expect": "stop", "policy": "B", "class": "git-c-hooks", "why": "Config override disables hooks for commit"}
{"id": "QW022", "command": "echo \"\" > .githooks/pre-commit", "expect": "stop", "policy": "B", "class": "empty-hook", "why": "Empties hook file content"}
{"id": "QW023", "command": "git config --unset core.hooksPath", "expect": "stop", "policy": "B", "class": "unset-hooks-path", "why": "Unsets hooks path config"}
{"id": "QW024", "command": "rm -rf .git/hooks", "expect": "stop", "policy": "B", "class": "rm-git-hooks", "why": "Deletes entire hooks directory"}
{"id": "QW025", "command": "git config core.hooksPath ~/.githooks", "expect": "stop", "policy": "B", "class": "hooks-path-home", "why": "Points hooks outside repo directory"}
{"id": "QW026", "command": "git reset --hard", "expect": "stop", "policy": "C", "class": "reset-hard", "why": "Hard reset destroys all worktree changes"}
{"id": "QW027", "command": "git reset --hard HEAD", "expect": "stop", "policy": "C", "class": "reset-hard-head", "why": "Hard reset to HEAD destroys worktree"}
{"id": "QW028", "command": "git clean -fd", "expect": "stop", "policy": "C", "class": "clean-force-dirs", "why": "Force cleans all untracked files and directories"}
{"id": "QW029", "command": "git clean -fdx", "expect": "stop", "policy": "C", "class": "clean-force-ignored", "why": "Force cleans including ignored files"}
{"id": "QW030", "command": "git checkout -- .", "expect": "stop", "policy": "C", "class": "checkout-all", "why": "Discards all worktree changes"}
{"id": "QW031", "command": "git checkout HEAD -- .", "expect": "stop", "policy": "C", "class": "checkout-head-all", "why": "Restores all files from HEAD discarding changes"}
{"id": "QW032", "command": "git push --force", "expect": "stop", "policy": "C", "class": "push-force", "why": "Force push overwrites remote history"}
{"id": "QW033", "command": "git push -f", "expect": "stop", "policy": "C", "class": "push-f", "why": "Force push with short flag"}
{"id": "QW034", "command": "git push origin +main", "expect": "stop", "policy": "C", "class": "push-plus-ref", "why": "Plus prefix forces push to main"}
{"id": "QW035", "command": "git branch -D feature", "expect": "stop", "policy": "C", "class": "branch-force-delete", "why": "Force deletes unmerged branch"}
{"id": "QW036", "command": "git stash drop", "expect": "stop", "policy": "C", "class": "stash-drop", "why": "Drops stash losing saved work"}
{"id": "QW037", "command": "git stash clear", "expect": "stop", "policy": "C", "class": "stash-clear", "why": "Clears all stashes"}
{"id": "QW038", "command": "git reflog expire --expire=now --all", "expect": "stop", "policy": "C", "class": "reflog-expire", "why": "Expires all reflogs losing history"}
{"id": "QW039", "command": "rm -rf .git", "expect": "stop", "policy": "C", "class": "rm-git-dir", "why": "Deletes entire git directory"}
{"id": "QW040", "command": "git reset --hard HEAD~1", "expect": "stop", "policy": "C", "class": "reset-hard-parent", "why": "Hard reset to parent destroys work"}
{"id": "QW041", "command": "git add src/file.js", "expect": "allow", "policy": "none", "class": "stage-named-file", "why": "Stages specific named file"}
{"id": "QW042", "command": "git add src/", "expect": "allow", "policy": "none", "class": "stage-named-dir", "why": "Stages specific named directory"}
{"id": "QW043", "command": "git commit -m \"fix: --force flag\"", "expect": "allow", "policy": "none", "class": "commit-force-in-msg", "why": "Commit message contains --force but doesn't use it"}
