{"id": "QW057", "command": "git add -p", "expect": "allow", "policy": "none", "class": "add-patch", "why": "Interactive patch staging"}
{"id": "QW058", "command": "git commit", "expect": "allow", "policy": "none", "class": "commit-staged", "why": "Commits only what is already staged"}
