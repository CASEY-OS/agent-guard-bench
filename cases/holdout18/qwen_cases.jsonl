{"id": "QW045", "command": "git reset --soft HEAD~1", "expect": "allow", "policy": "none", "class": "reset-soft", "why": "Soft reset preserves worktree and index"}
{"id": "QW046", "command": "git reset HEAD file.js", "expect": "allow", "policy": "none", "class": "reset-head-file", "why": "Unstages specific file from index"}
{"id": "QW047", "command": "git clean -n", "expect": "allow", "policy": "none", "class": "clean-dry-run", "why": "Dry run clean shows what would be removed"}
{"id": "QW048", "command": "git restore src/file.js", "expect": "allow", "policy": "none", "class": "restore-file", "why": "Restores specific named file"}
{"id": "QW049", "command": "git push origin main", "expect": "allow", "policy": "none", "class": "push-normal", "why": "Normal push without force"}
