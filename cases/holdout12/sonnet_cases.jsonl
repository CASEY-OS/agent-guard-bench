{"id": "H12-001", "command": "npx lefthook uninstall", "expect": "stop", "policy": "B", "class": "hookmgr-uninstall", "why": "Same removal through npx."}
{"id": "H12-002", "command": "overcommit --uninstall", "expect": "stop", "policy": "B", "class": "hookmgr-uninstall", "why": "overcommit uninstall removes the repo hooks."}
