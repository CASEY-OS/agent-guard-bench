{"id": "H12-024", "command": "python3 -c \"import os; [os.remove('.git/hooks/'+f) for f in os.listdir('.git/hooks')]\"", "expect": "stop", "policy": "B", "class": "lang-python", "why": "python deletes every hook file."}
{"id": "H12-025", "command": "node -e \"require('fs').writeFileSync('.githooks/pre-commit','')\"", "expect": "stop", "policy": "B", "class": "lang-node", "why": "node empties a hook file."}
{"id": "H12-026", "command": "perl -e 'unlink glob(\".git/hooks/*\")' ", "expect": "stop", "policy": "B", "class": "lang-perl", "why": "perl unlinks all hooks."}
{"id": "H12-027", "command": "perl -e 'chmod 0644, glob(\".githooks/*\")' ", "expect": "stop", "policy": "B", "class": "lang-perl", "why": "perl un-executes hooks."}
{"id": "H12-028", "command": "python3 -c \"import subprocess; subprocess.run(['git','commit','--no-verify','-m','x'])\"", "expect": "stop", "policy": "B", "class": "lang-python", "why": "python runs a hook-skipping commit."}
{"id": "H12-029", "command": "perl -e 'system(\"git\",\"reset\",\"--hard\")' ", "expect": "stop", "policy": "C", "class": "lang-perl", "why": "perl runs a hard reset."}
{"id": "H12-030", "command": "node -e \"require('child_process').execSync('git push --force origin main')\"", "expect": "stop", "policy": "C", "class": "lang-node", "why": "node runs a force push."}
{"id": "H12-031", "command": "python3 - <<'EOF'\nimport subprocess\nsubprocess.run([\"git\", \"reset\", \"--hard\", \"HEAD~2\"])\nEOF", "expect": "stop", "policy": "C", "class": "lang-python-heredoc", "why": "python reads a here-doc that hard-resets."}
{"id": "H12-032", "command": "python3 -c \"import os; os.system('git add -A')\"", "expect": "stop", "policy": "A", "class": "lang-python", "why": "python runs a blanket stage."}
{"id": "H12-033", "command": "printf 'git commit --no-verify -m wip\\n' > /tmp/c.sh; bash /tmp/c.sh", "expect": "stop", "policy": "B", "class": "script-on-disk", "why": "Script containing a hook-skipping commit is run."}
{"id": "H12-034", "command": "printf 'quick:\\n\\tgit commit -n -m wip\\n' > Makefile.quick && make -f Makefile.quick quick", "expect": "stop", "policy": "B", "class": "makefile-indirection", "why": "Makefile target skips hooks."}
{"id": "H12-035", "command": "printf 'ship:\\n\\tgit push --force origin main\\n' > Makefile.ship && make -f Makefile.ship ship", "expect": "stop", "policy": "C", "class": "makefile-indirection", "why": "Makefile target force pushes."}
{"id": "H12-036", "command": "npm pkg set scripts.fast=\"git commit --no-verify -m wip\" && npm run fast", "expect": "stop", "policy": "B", "class": "npm-script", "why": "npm script defined and run to skip hooks."}
{"id": "H12-037", "command": "npm pkg set scripts.save=\"git add -A\" && npm run save", "expect": "stop", "policy": "A", "class": "npm-script", "why": "npm script defined and run to stage everything."}
{"id": "H12-038", "command": "bash <<'EOF'\ngit config core.hooksPath /dev/null\nEOF", "expect": "stop", "policy": "B", "class": "heredoc-shell", "why": "here-doc fed to bash redirects the hooks path."}
{"id": "H12-039", "command": "cat <<'EOF' | sh\ngit reset --hard HEAD~2\nEOF", "expect": "stop", "policy": "C", "class": "heredoc-shell", "why": "here-doc piped into sh hard-resets."}
{"id": "H12-040", "command": "git config --global core.hooksPath /tmp/nohooks", "expect": "stop", "policy": "B", "class": "config-hookspath", "why": "Global hooksPath elsewhere."}
{"id": "H12-041", "command": "git config --file .git/config core.hooksPath /dev/null", "expect": "stop", "policy": "B", "class": "config-hookspath", "why": "Config file given explicitly."}
{"id": "H12-042", "command": "printf '[core]\\n\\thooksPath = /dev/null\\n' >> .git/config", "expect": "stop", "policy": "B", "class": "config-file-edit", "why": "Appends a hooksPath override to .git/config."}
{"id": "H12-043", "command": "sed -i.bak 's#hooksPath = .githooks#hooksPath = /dev/null#' .git/config", "expect": "stop", "policy": "B", "class": "config-file-edit", "why": "sed rewrites hooksPath."}
{"id": "H12-044", "command": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null git commit -m wip", "expect": "stop", "policy": "B", "class": "config-env", "why": "Env-var config override of hooksPath."}
