{"id": "H12-007", "command": "brew uninstall lefthook && rm -f lefthook.yml .git/hooks/pre-commit", "expect": "stop", "policy": "B", "class": "hookmgr-uninstall", "why": "Removes lefthook, its config and the hook it installed."}
{"id": "H12-008", "command": "pipx uninstall pre-commit", "expect": "stop", "policy": "B", "class": "hookmgr-uninstall-only", "why": "Removes the pre-commit tool; installed hook then errors or is gutted; unsure."}
{"id": "H12-009", "command": "find .git/hooks -type f -delete", "expect": "stop", "policy": "B", "class": "find-hooks", "why": "find -delete over the hooks directory."}
{"id": "H12-010", "command": "find .git/hooks -type f -exec rm {} +", "expect": "stop", "policy": "B", "class": "find-hooks", "why": "find -exec rm over hook files."}
