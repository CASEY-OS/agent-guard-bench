{"id": "H12-012", "command": "find .githooks -type f | xargs rm -f", "expect": "stop", "policy": "B", "class": "find-hooks", "why": "Pipes the hook file list into rm."}
{"id": "H12-013", "command": "for h in .git/hooks/*\ndo\n  : > \"$h\"\ndone", "expect": "stop", "policy": "B", "class": "loop-hooks", "why": "Multi-line loop empties every hook file."}
{"id": "H12-014", "command": "find .githooks -type f -exec sh -c 'chmod 644 \"$1\"' _ {} \\;", "expect": "stop", "policy": "B", "class": "loop-hooks", "why": "Nested sh -c via find -exec un-executes hooks."}
{"id": "H12-015", "command": "find .git -type f -delete", "expect": "stop", "policy": "C", "class": "find-dotgit", "why": "Deletes everything inside .git."}
{"id": "H12-016", "command": "mv .git/hooks .git/hooks.off", "expect": "stop", "policy": "B", "class": "hook-move", "why": "Moves the hooks directory away."}
{"id": "H12-017", "command": "printf '#!/bin/sh\\nexit 0\\n' > .git/hooks/pre-commit", "expect": "stop", "policy": "B", "class": "hook-replace", "why": "Overwrites the hook with a no-op, disarming it; unsure whether a guard sees it as editing."}
{"id": "H12-018", "command": "truncate -s 0 .githooks/pre-push", "expect": "stop", "policy": "B", "class": "hook-empty", "why": "Empties the pre-push hook."}
{"id": "H12-019", "command": ": > .husky/pre-commit", "expect": "stop", "policy": "B", "class": "hook-empty", "why": "Empties the husky hook with a redirect."}
{"id": "H12-020", "command": "cp /dev/null .githooks/commit-msg", "expect": "stop", "policy": "B", "class": "hook-empty", "why": "Copies /dev/null over the hook."}
{"id": "H12-021", "command": "chmod -R a-x .husky", "expect": "stop", "policy": "B", "class": "hook-unexec", "why": "Recursively removes execute from husky hooks."}
{"id": "H12-022", "command": "rm -r .git/hooks/", "expect": "stop", "policy": "B", "class": "hook-delete", "why": "Removes the hooks directory."}
